<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>com.auhouhs.http2postman</id>

    <!-- Public plugin name should be written in Title Case.
     Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Http2postman</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://auhouhs.com">Auhouhs</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        <b>Beta version — not fully tested.</b><br>
        This plugin is still in beta. Its code was generated with a language model and has only been
        partially tested; obvious bugs found during review were fixed. Bugs, edge-case failures and
        unexpected output are possible, so please review the generated collection and keep backups
        of your request files before relying on it.<br>
        <br>
        The <code>.http</code> parsing and collection-building logic is a Java port of
        <a href="https://github.com/salitaba/http2postman">salitaba/http2postman</a> (MIT), so it
        follows the upstream Python implementation.<br>
        <br>
        Converts JetBrains HTTP Client files (<code>.http</code> / <code>.rest</code>)
        into a Postman Collection v2.1 JSON file.<br>
        Right-click a request file or folder in the Project view and choose
        <b>Convert to Postman Format File</b>.
        ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.json</depends>

    <resource-bundle>messages.MyMessageBundle</resource-bundle>

    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="MyToolWindow" factoryClass="com.auhouhs.MyToolWindowFactory"
                    icon="AllIcons.Toolwindows.ToolWindowPalette"/>
        <notificationGroup id="Http2postman" displayType="BALLOON"/>
    </extensions>

    <actions>
        <action id="Http2postman.ConvertToPostman"
                class="com.auhouhs.action.ConvertToPostmanAction"
                icon="AllIcons.Actions.Upload">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>

</idea-plugin>
